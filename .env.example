# Path to your Google Ads API YAML config. Leave unset to use ~/google-ads.yaml.
GOOGLE_ADS_YAML_PATH=./google-ads.yaml

# Optional login customer ID for manager-account access. Digits only, no dashes.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Default customer ID for tools when the caller omits customer_id.
GOOGLE_ADS_DEFAULT_CUSTOMER_ID=

# Audit logs are JSONL files written here.
GOOGLE_ADS_MCP_AUDIT_DIR=./audit

# Default safety mode. Tool calls can still pass dry_run explicitly.
GOOGLE_ADS_MCP_DRY_RUN=true

# Comma-separated allowlist. Reads remain available when empty; every write fails closed.
GOOGLE_ADS_ALLOWED_CUSTOMER_IDS=

# Max percent increase/decrease permitted for set_campaign_budget.
GOOGLE_ADS_MAX_BUDGET_CHANGE_PCT=30
